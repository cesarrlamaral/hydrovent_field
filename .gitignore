# Backups locais do próprio repositório — nunca devem ser versionados
# (arquivo grande, conteúdo duplica tudo, inclusive o que é
# deliberadamente excluído acima).
*.zip
*backup*

# Dados gerados por runs/ensembles — totalmente reproduzíveis a partir do
# seed (ver docs/PHYSICS_MODEL.md), não faz sentido versionar (>1GB e cresce
# a cada run).
outputs/
outputs_*/

# PDFs de artigos de terceiros (obtidos por canais legítimos para
# verificação de citação, mas não redistribuíveis publicamente por padrão —
# ver conversa sobre direitos autorais) e rascunhos de texto do autor.
biblios/
paper/

# Ferramentas pessoais do autor, fora do escopo deste projeto —
# deliberadamente mantidas fora do histórico público.
report.py
relatorios_admin.py
docx_export.py
tests/test_report.py
docs/CITATIONS_TO_VERIFY.md

# Texto de normas de autoria de terceiros (editora), não redistribuído
# aqui por precaução de direitos autorais.
docs/JOURNAL_AUTHOR_RULES.txt

# Python
__pycache__/
*.pyc
.pytest_cache/

# Configuração local de ferramenta de desenvolvimento (allowlist de
# permissões desta máquina), não é parte do projeto.
.claude/
