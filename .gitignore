# Dados gerados por runs/ensembles — totalmente reproduzíveis a partir do
# seed (ver docs/PHYSICS_MODEL.md), não faz sentido versionar (>1GB e cresce
# a cada run).
outputs/
outputs_*/

# PDFs de artigos de terceiros (obtidos por canais legítimos para
# verificação de citação, mas não redistribuíveis publicamente por padrão —
# ver conversa sobre direitos autorais) e rascunhos do manuscrito.
biblios/
paper/

# Ferramentas pessoais de preparo de manuscrito (Astrobiology/PLOS/JOSS),
# não parte do hydrovent_field: gerador de relatório/paper e o script
# administrativo que o expõe (texto de interpretação científica específico
# do autor, login protegido por senha), o exportador de .docx que eles
# usam, e a trilha de auditoria de citações do texto do manuscrito —
# deliberadamente mantidos fora do histórico público.
report.py
relatorios_admin.py
docx_export.py
tests/test_report.py
docs/CITATIONS_TO_VERIFY.md

# Texto das normas de autoria da SAGE/Astrobiology colado integralmente de
# journals.sagepub.com/author-instructions/ASB — conteúdo de terceiros
# (editora), não redistribuído aqui por precaução de direitos autorais.
docs/ASTROBIOLOGY_SAGE_AUTHOR_RULES.txt

# Python
__pycache__/
*.pyc
.pytest_cache/

# Configuração local do Claude Code (allowlist de permissões desta máquina,
# não é parte do projeto)
.claude/
